# Environment variables for Docker Compose development

# Application
PORT=8080
NODE_ENV=development

# DynamoDB Local (for development)
DOCUMENT_API_ENDPOINT=http://dynamodb-local:8000
DOCUMENT_API_REGION=ru-central1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
USE_DATABASE=true

# Telegram bot (webhook). Токен хранится только в переменной окружения, не в коде.
# BOT_PUBLIC_URL — публичный адрес приложения на сервере (Railway), например
# https://go-kod-bot.up.railway.app (нужен, чтобы бот отдавал ссылки на фото маршрутов).
# BOT_WEBHOOK_URL — тот же публичный адрес; также используется для регистрации webhook
# командой npm run bot:webhook. BOT_SECRET_TOKEN — необязательный секрет для проверки запросов.
# TELEGRAM_BOT_TOKEN=
# BOT_PUBLIC_URL=
# BOT_WEBHOOK_URL=
# BOT_SECRET_TOKEN=
